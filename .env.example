# DataDaddy optional configuration.
# All core simulation features work WITHOUT any keys.
# If set, the DataDaddy Intelligence analyst will call an LLM to phrase grounded answers.
# Without it, a deterministic explanation generator is used instead.

# OpenAI-compatible endpoint (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
